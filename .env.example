# Where the room server lives. Unset it and the game plays solo exactly as before,
# with the Multiplayer row disabled — see src/net/room.ts.
#
# Local development, alongside `npx wrangler dev --port 8787`:
VITE_ROOM_URL=ws://localhost:8787
#
# Deployed, after `npx wrangler deploy`:
# VITE_ROOM_URL=wss://ballern-rooms.<your-subdomain>.workers.dev

# The Apps Script web app behind the waitlist form on the `/` landing page.
# Unset it and the form disables itself instead of eating submissions nobody
# can read — see src/waitlist/main.ts and tools/waitlist/Code.gs.
# VITE_WAITLIST_URL=https://script.google.com/macros/s/<deployment-id>/exec
# VITE_WAITLIST_SECRET=<same string as SHARED_SECRET in Code.gs>
